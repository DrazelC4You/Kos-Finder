# ===============================================
# KOSFINDER ENVIRONMENT CONFIGURATION EXAMPLE
# Salin bagian SERVER ke server/.env dan bagian CLIENT ke client/.env
# JANGAN PERNAH COMMIT FILE .env KE GIT!
# ===============================================

# -----------------------------------------------
# SERVER (server/.env)
# -----------------------------------------------
PORT=5000
NODE_ENV=development

# DATABASE (PostgreSQL)
# Jika server PostgreSQL tidak tersedia, aplikasi otomatis memakai
# penyimpanan in-memory berisi data seed agar tetap bisa dikembangkan.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kosfinder?schema=public"

# SEED DATA DEMO saat server boot (hanya jika tabel user masih kosong)
# Akun demo memakai password seragam "Password123!" yang tercantum di repo,
# termasuk akun ADMIN. Biarkan kosong/false di produksi; isi true hanya untuk
# deploy demo atau pengujian lokal.
# SEED_DEMO_DATA=true

# AUTHENTICATION (JWT)
# Wajib diganti dengan string acak panjang di produksi.
JWT_SECRET=kosfinder_super_secret_jwt_key_development_2026
JWT_EXPIRES_IN=7d

# CORS CONFIGURATION
CORS_ORIGIN=http://localhost:5173

# CLIENT URL — dipakai untuk membangun tautan reset password di email
CLIENT_URL=http://localhost:5173

# RATE LIMIT (opsional)
# Default: 200 request/15 menit di produksi, 5000 di development.
# RATE_LIMIT_MAX=200

# IMAGE UPLOAD / STORAGE
# Driver penyimpanan: local (default). Arsitektur siap dikembangkan ke s3/cloudinary.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Batas ukuran per file dalam byte (default 2MB = 2097152)
UPLOAD_MAX_SIZE=2097152
# Base URL publik server (untuk membangun URL absolut file upload bila diperlukan)
PUBLIC_BASE_URL=http://localhost:5000

# EMAIL / SMTP (opsional — untuk pengiriman email reset password)
# Jika SMTP_HOST tidak diisi, tautan reset hanya dicetak ke console server (mode development).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="KosFinder <no-reply@kosfinder.com>"

# CLOUDFLARE TURNSTILE (anti-bot captcha di halaman register)
# Jika tidak diisi, captcha dinonaktifkan (cocok untuk development lokal).
# Nilai di bawah adalah TEST KEY resmi Cloudflare yang selalu lolos — ganti
# dengan secret asli dari dashboard Cloudflare Turnstile untuk produksi.
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------
# CLIENT (client/.env)
# -----------------------------------------------
# Tidak dibaca kode saat ini: services/api.js memakai baseURL '/api' supaya
# satu origin jalan di dev (proxy Vite) maupun prod (Express serve-static).
# VITE_API_BASE_URL=http://localhost:5000/api

# ALAMAT SUPPORT untuk blok kontak FAQ di halaman utama.
# Kosongkan jika belum ada alamat resmi — blok "Masih ada pertanyaan?" tidak
# akan dirender sama sekali.
# VITE_SUPPORT_EMAIL=support@kosfinder.com

# PETA (Leaflet tile layer)
# Default memakai OpenStreetMap (gratis, tanpa API key).
# Untuk provider berbayar (MapTiler, dsb), isi URL tile beserta key-nya di sini.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# CLOUDFLARE TURNSTILE SITE KEY (dipasangkan dengan TURNSTILE_SECRET_KEY di server)
# Nilai di bawah adalah TEST KEY resmi Cloudflare yang selalu lolos — ganti
# dengan site key asli dari dashboard Cloudflare Turnstile untuk produksi.
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# -----------------------------------------------
# CATATAN PRODUKSI (Render)
# -----------------------------------------------
# Deploy memakai render.yaml (Blueprint). Yang perlu kamu isi manual di
# dashboard Render (menu Environment):
#   - CLIENT_URL      = URL aplikasi, mis. https://kosfinder.onrender.com
#   - CORS_ORIGIN     = sama dengan CLIENT_URL
#   - TURNSTILE_SECRET_KEY = secret ASLI dari dashboard Cloudflare Turnstile
#   - SMTP_HOST/PORT/USER/PASS = opsional, untuk email beneran (Gmail App Password)
# DATABASE_URL dan JWT_SECRET sudah otomatis diisi oleh Blueprint.
# Catatan: VITE_* dibakar saat build (file client/.env), bukan saat runtime.
